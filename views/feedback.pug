extends layout

block headMeta
  meta(name="description" content="Обратная связь - оставьте свой отзыв о Listing Tracker")
  meta(name="keywords" content="обратная связь, отзыв, контакты")

block content
  main.main
    if showSaved
      p(style="padding:1rem;background:#ecfdf5;border-radius:0.5rem;margin-bottom:1rem") Спасибо! Отзыв сохранён.
    section.feedback-section
      h2 Обратная связь
      p Мы ценим ваше мнение! Поделитесь своими впечатлениями о нашем сервисе или задайте вопрос.
      form.feedback-form#feedback-form(
        method="post"
        action="/feedbacks"
      )
        input(type="hidden" name="next" value="/feedback?saved=1")
        fieldset.form__fieldset
          legend.form__legend= isAuth ? `Отзыв от ${userName}` : 'Оставить отзыв'
          .form__group
            label.form__label-text(for="message")
              | Комментарий 
              span.form__required *
            textarea#message.form__textarea(
              name="message"
              required=isAuth
              minlength=isAuth ? "10" : undefined
              maxlength="1000"
              rows="5"
              placeholder="Ваш отзыв или вопрос..."
            )
          .form__group
            label.form__label-text(for="rating") Оценка
            select#rating.form__select(name="rating")
              option(value="" selected) Выберите оценку
              option(value="5") Отлично (5)
              option(value="4") Хорошо (4)
              option(value="3") Удовлетворительно (3)
              option(value="2") Плохо (2)
              option(value="1") Очень плохо (1)
          div(style="display:flex;gap:1rem;flex-wrap:wrap")
            if isAuth
              button.form__submit(type="submit") Отправить отзыв
            else
              a.form__submit(href="/login?next=/feedback") Отправить отзыв
    section.feedback-list-section
      h2 Отзывы пользователей
      if recentFeedbacks.length === 0
        .feedback-list
          p(style="text-align:center;color:var(--text-light);padding:2rem") Пока нет отзывов. Будьте первым!
      else
        .feedback-list
          each f in recentFeedbacks
            article.feedback-item
              .feedback-item__header
                h3.feedback-item__name= f.user.displayName
                .feedback-item__meta
                  if f.user.email === 'guest@listing-tracker.local'
                    span.feedback-item__email —
                  else
                    span.feedback-item__email= f.user.email
                  span.feedback-item__date= f.createdAt.toLocaleDateString('ru-RU')
                  if f.rating != null
                    span.feedback-item__rating= '★'.repeat(f.rating)
              p.feedback-item__comment(style="white-space:pre-wrap")= f.message
    #api-comments-root

block pageScripts
  script(crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js")
  script(crossorigin src="https://unpkg.com/react@18/umd/react-dom.production.min.js")
  script(type="module" src="/js/main.js")
  script(type="module" src="/js/api-app.js")
