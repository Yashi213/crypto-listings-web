extends ../layout

block content
  main.main.record-detail
    h2.record-detail__heading= listing.title
    p
      strong Статус:
      |  #{listing.status === 'UPCOMING' ? 'Предстоящий' : 'Недавний'}
    p
      strong Биржа:
      |  #{listing.exchange.name}
    p
      strong Дата:
      |  #{listing.dateAt.toLocaleString('ru-RU')}
    if listing.asset
      p
        strong Основной актив:
        |  #{listing.asset.symbol} (#{listing.asset.name})
    if listing.description
      p(style="white-space:pre-wrap")= listing.description
    h3 Торговые пары
    if listing.pairs.length > 0
      ul
        each pair in listing.pairs
          li
            = pair.baseAsset.symbol + '/' + pair.quoteAsset.symbol
            |  
            form.inline-delete(method="post" action=`/listings/${listing.id}/pairs/${pair.id}/delete` style="display:inline;margin-left:0.5rem" onsubmit="return confirm('Удалить пару?');")
              button.link-button(type="submit") Удалить
    else
      p Пар пока нет.
    if assets.length >= 2
      h4 Добавить пару
      form.form(method="post" action=`/listings/${listing.id}/pairs` style="max-width:28rem")
        label.form__label
          | Базовый актив
          select.form__input(name="baseAssetId" required)
            each a in assets
              option(value=a.id)= a.symbol + ' — ' + a.name
        label.form__label
          | Котируемый актив
          select.form__input(name="quoteAssetId" required)
            each a in assets
              option(value=a.id)= a.symbol + ' — ' + a.name
        p
          button.btn(type="submit") Добавить пару
    else
      p Для пар нужно минимум два актива в&nbsp;
        a(href="/assets") справочнике
        | .
    nav.record-detail__actions
      a.nav__link(href=`/listings/${listing.id}/edit`) Редактировать
      a.nav__link(href="/listings") К списку
    .record-detail__danger
      form.inline-delete(method="post" action=`/listings/${listing.id}/delete` onsubmit="return confirm('Удалить листинг?');")
        button.link-button(type="submit") Удалить
