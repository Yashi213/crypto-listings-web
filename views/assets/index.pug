extends ../layout

block content
  main.main
    h2 Активы (монеты / токены)
    if isAdmin
      p.crud-toolbar
        a.btn(href="/assets/add") + Добавить актив
    if items.length === 0
      p Справочник пуст. Добавьте тикеры (BTC, USDT, …) для листингов и пар.
    else
      table.stats-table
        thead
          tr
            th Тикер
            th Название
            th.stats-table__actions Действия
        tbody
          each a in items
            tr
              td(data-label="Тикер")
                a(href=`/assets/${a.id}`)= a.symbol
              td(data-label="Название")= a.name
              td.stats-table__actions(data-label="Действия")
                if isAdmin
                  a(href=`/assets/${a.id}/edit`) Изменить
                  |  
                  form.inline-delete(method="post" action=`/assets/${a.id}/delete` style="display:inline" onsubmit="return confirm('Удалить актив? Его нельзя удалить, если он используется.');")
                    button.link-button(type="submit") Удалить
                else
                  | —
