doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    block headMeta
    title= pageTitle || 'Listing Tracker'
    include partials/styles
    block headExtra
  body
    include partials/header
    block content
    include partials/footer
    include partials/scripts
    block pageScripts
