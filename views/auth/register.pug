extends ../layout

block content
  main.main.crud-form
    h2 Регистрация
    if error
      p.form__error= error
    form.form#auth-form(data-mode="signup" data-next=next)
      fieldset.form__fieldset
        legend.form__legend Новый аккаунт
        label.form__label
          | Имя
          input.form__input#displayName(type="text" name="displayName" autocomplete="name" minlength="2" placeholder="Как к вам обращаться")
        label.form__label
          | Email
          input.form__input#email(type="email" name="email" required autocomplete="username")
        label.form__label
          | Пароль
          input.form__input#password(type="password" name="password" required autocomplete="new-password" minlength="8")
      p(style="margin:1.5rem 0 0;display:flex;flex-wrap:wrap;gap:0.75rem 1rem;align-items:center")
        button.btn.form__submit(type="submit") Создать аккаунт
        a.nav__link(href="/login") Уже есть аккаунт? Войти

block pageScripts
  script(src="/js/auth-form.js")
