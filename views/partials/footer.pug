footer.footer
  .footer__banner.hide-mobile
    .footer__banner-content
      span.footer__banner-icon 🚀
      p.footer__banner-text
        strong Премиум подписка:
        |  Получайте листинги на 5 минут раньше всех!
        a.footer__banner-link(href="#premium")  Попробовать бесплатно →
  .footer__content
    address.footer__address
      p Контакты: info@listing-tracker.com
      p Telegram: @listing_tracker
    p &copy; 2024 Listing Tracker. Все права защищены.
    p.footer__timing#page-timing
      if typeof serverElapsedMs === 'number'
        span#server-elapsed Сервер: #{serverElapsedMs} мс
        |  
      span#page-load-time
    nav.footer__nav
      ul.footer__list
        li
          a.footer__link(href="/privacy") Политика конфиденциальности
        li
          a.footer__link(href="/terms") Условия использования
