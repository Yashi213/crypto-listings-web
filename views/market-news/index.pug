extends ../layout

block content
  main.main
    h2 Новости рынка
    if isAdmin
      p.crud-toolbar
        a.btn(href="/market-news/add") + Добавить новость
    if items.length === 0
      p Записей нет. Нужна хотя бы одна биржа в&nbsp;
        a(href="/exchanges") справочнике
        | .
    else
      table.stats-table
        thead
          tr
            th Заголовок
            th Биржа
            th Дата
            th Порядок
            th.stats-table__actions Действия
        tbody
          each n in items
            tr
              td(data-label="Заголовок")
                a(href=`/market-news/${n.id}`)= n.title
              td(data-label="Биржа")= n.exchange.name
              td(data-label="Дата")= n.publishedAt.toLocaleString('ru-RU')
              td(data-label="Порядок")= n.sortOrder
              td.stats-table__actions(data-label="Действия")
                if isAdmin
                  a(href=`/market-news/${n.id}/edit`) Изменить
                  |  
                  form.inline-delete(method="post" action=`/market-news/${n.id}/delete` style="display:inline" onsubmit="return confirm('Удалить новость?');")
                    button.link-button(type="submit") Удалить
                else
                  | —
