PORT=4000
DATABASE_URL=postgresql://user:password@host:port/database

# Yandex Object Storage (S3 API)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=your-public-bucket
S3_ACCESS_KEY_ID=your-static-access-key-id
S3_SECRET_ACCESS_KEY=your-static-secret-key

# Необязательно: CDN или собственный домен бакета
# S3_PUBLIC_BASE_URL=https://storage.yandexcloud.net/your-public-bucket
