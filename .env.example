PORT=4000
DATABASE_URL=postgresql://user:password@host:port/database

# Yandex Object Storage (S3 API)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=your-public-bucket
S3_ACCESS_KEY_ID=your-static-access-key-id
S3_SECRET_ACCESS_KEY=your-static-secret-key

# Необязательно: CDN или собственный домен бакета
# S3_PUBLIC_BASE_URL=https://storage.yandexcloud.net/your-public-bucket

# SuperTokens. Локально достаточно try.supertokens.com; на Render — Managed Core + те же ключи в Environment.
# Свой Core: docker run -p 3567:3567 -d registry.supertokens.io/supertokens/supertokens-inmemory
SUPERTOKENS_CONNECTION_URI=https://try.supertokens.com
SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME=Listing Tracker
SUPERTOKENS_API_DOMAIN=http://localhost:4000
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:4000
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_WEBSITE_BASE_PATH=/login
# Email администраторов через запятую (роль ADMIN после входа)
ADMIN_EMAILS=admin@example.com

# На Render задайте публичный URL сервиса; используется как fallback для обоих доменов.
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
