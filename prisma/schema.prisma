generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  UPCOMING
  RECENT
}

model User {
  id          String   @id @default(cuid())
  /// ID пользователя в SuperTokens (связка сессии с записью в нашей БД)
  authId      String?  @unique
  email       String   @unique
  displayName String
  role        UserRole @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feedbacks Feedback[]
  favorites Favorite[]
}

/// Криптоактив (монета/токен): справочник для листингов и пар
model Asset {
  id          String   @id @default(cuid())
  symbol      String   @unique
  name        String
  description String?
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listingsPrimary Listing[]     @relation("ListingPrimaryAsset")
  pairsAsBase     TradingPair[] @relation("TradingPairBase")
  pairsAsQuote    TradingPair[] @relation("TradingPairQuote")
}

/// Новости рынка (блок на главной); источник — конкретная биржа
model MarketNews {
  id          String   @id @default(cuid())
  title       String
  publishedAt DateTime
  imageUrl    String
  imageAlt    String
  summary     String?
  sourceUrl   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exchangeId String
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
}

model Exchange {
  id        String   @id @default(cuid())
  name      String   @unique
  website   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings  Listing[]
  marketNews MarketNews[]
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  status      ListingStatus
  dateAt      DateTime
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  exchangeId String
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset? @relation("ListingPrimaryAsset", fields: [assetId], references: [id], onDelete: SetNull)

  pairs     TradingPair[]
  favorites Favorite[]
}

model TradingPair {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  baseAssetId String
  baseAsset   Asset @relation("TradingPairBase", fields: [baseAssetId], references: [id], onDelete: Restrict)

  quoteAssetId String
  quoteAsset   Asset @relation("TradingPairQuote", fields: [quoteAssetId], references: [id], onDelete: Restrict)

  @@unique([listingId, baseAssetId, quoteAssetId])
}

model Feedback {
  id        String   @id @default(cuid())
  message   String
  rating    Int?
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}
